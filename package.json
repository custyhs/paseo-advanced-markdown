{
  "name": "paseo-advanced-markdown",
  "version": "0.1.0",
  "private": true,
  "description": "Advanced Markdown rendering for Paseo 0.8: math formulas and Mermaid diagrams in assistant messages",
  "type": "module",
  "license": "Apache-2.0",
  "repository": "github:custyhs/paseo-advanced-markdown",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare-browser": "node scripts/prepare-browser.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "paseo-source": "node scripts/paseo-source.mjs",
    "smoke": "node --import tsx scripts/smoke.mjs",
    "check": "npm run build && npm run typecheck && npm test",
    "smoke:hermes": "node --import tsx scripts/hermes-smoke.mjs"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "markdown-it": "15.0.1",
    "mathjax-full": "3.2.2",
    "react-native-markdown-display": "7.0.2"
  },
  "overrides": {
    "react-native-markdown-display": {
      "markdown-it": "$markdown-it"
    },
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/plugin-transform-classes": "7.28.6",
    "@getpaseo/plugin": "0.8.0",
    "@getpaseo/server": "0.8.0",
    "@puppeteer/browsers": "3.2.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^25.11.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "0.21.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0",
    "zod": "4.4.3"
  }
}
